# Build output
/bin/
/dist/
web/dist/
# Staged copy of the built frontend, produced by "make web".
internal/web/dist/*
!internal/web/dist/.gitkeep
*.test
coverage.out
# Test fixtures built from ./tools; scripts/e2e.sh puts them in a temp dir,
# but a bare "go build ./tools/..." drops them here.
/testsshd

# Local development
.env
*.local.yaml
/tmp/

# Secrets — never commit
*.key
master.key
*.pem
!testdata/**/*.pem
*.bkbundle

# Node
node_modules/
.pnpm-store/
web/test-results/
web/playwright-report/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Browser-automation scratch output
.playwright-mcp/
.claude/launch.json
